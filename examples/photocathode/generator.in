! CLARA 400 Hz gun laser as a macroparticle distribution (ASTRA generator.in, read natively by slipstream).
! Only the shape of the laser pulse matters when the Injector has a Photocathode: the charge comes from the
! laser energy and quantum efficiency, Q_total merely weights the macroparticles.
! The transverse profile is the cut Gaussian fitted to the virtual-cathode image of 2022-04-29 10:14 UTC by
! fit_laser_image.py (+-0.04 mm on sig_x, +-0.02 mm on sig_y, +-0.15 on C_sig_x, +-0.3 on C_sig_y); the emission
! time and energy are assumed, not measured.
&INPUT
  FName = 'generator.txt',
  Ipart = 4000,
  Species = 'electrons',
  Probe = .true.,
  Noise_reduc = .true.,
  High_res = .true.,
  Cathode = .true.,
  Q_total = 0.12,            ! nC
  Dist_z = 'p', Lt = 0.002, rt = 0.0002,   ! emission time: 2 ps flat-top with 0.2 ps edges (ns)
  Dist_x = 'g', sig_x = 0.565, C_sig_x = 1.55,   ! mm, gaussian cut at 1.55 sigma = +-0.875 mm
  Dist_y = 'g', sig_y = 0.344, C_sig_y = 2.32,   ! mm, gaussian cut at 2.32 sigma = +-0.797 mm
  Dist_pz = 'i', LE = 0.00062,             ! isotropic emission at 0.62 eV (keV)
  Ref_zpos = 0.0, Ref_Ekin = 0.0
/
