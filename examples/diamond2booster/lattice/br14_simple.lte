drift8,BD,drift9,BF,drift10,SS2,drift8,BD,drift11,SS1,drift6,Q1m,drift6,SS1,&
drift5,SS1,drift4,Q2m,drift1,BB,drift3,QS3m,drift2,QS2m,drift1,QS1m,drift14,&
CAVD,drift15)


!!! Add Q
Q: CHARGE

!!! Add Cleaner - 3*500MHZ Bucket width
cleaner: CLEAN, tlimit=3e-9, mode=absdeviation;

!!! Add watch points
w1: watch,filename="",mode="parameters",interval=10, FLUSH_INTERVAL=10;
w2: watch,filename="",mode="coord",interval=10000;

!!! Add IBS Scattering Element - MUST go at end of line
!IBS: IBSCATTER, nslice=32, force_matched_twiss=0, isring=1, bunched_beam_mode=0, filename="scatt.ibs",&
!smooth=1, DO_X=0, DO_Y=0, DO_Z=0, INTERVAL=100;

!!!Define Ring
BOOST: Line = (Q,ring)

