drift3,QS3m,drift2,QS2m,drift1,QS1m,drift12,CAV,drift13,QS1m,drift1,QS2m,&
drift2,QS3m,drift3,BB,drift1,Q2m,drift4,SS1,drift5,SS1,drift6,Q1m,drift6,SS1,&
drift7,SS2,drift8,BD,drift9,BF,drift10,SS2,drift8,BD,drift9,BF,drift10,SS2,&
drift8,BD,drift9,BF,drift10,SS2,drift8,BD,drift9,BF,drift9,BD,drift9,BF,&
drift10,SS2,drift8,BD,drift9,BF,drift10,SS2,drift8,BD,drift9,BF,drift10,SS2,&
